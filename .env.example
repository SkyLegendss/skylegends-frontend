# Copy to .env.local and fill in

# URL бэкенда (Railway)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Используется серверными API-роутами (не попадает в браузер)
BACKEND_URL=https://your-backend.railway.app

# NextAuth — сгенерируй командой: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# Учётные данные администратора
ADMIN_EMAIL=admin@skylegends.cz
ADMIN_PASSWORD=your-strong-password-here

# Секретный ключ для защиты API бэкенда (тот же, что в Railway)
ADMIN_API_KEY=your-admin-api-key-here
